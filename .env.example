# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://clawd:clawd@localhost:5432/clawd_agents"

# Redis — bridges events between the bot and worker processes (they're
# separate Node processes; this is how the bot learns about trades the
# worker made, to notify the user) and is available for future job queues.
REDIS_URL="redis://localhost:6379"

# ── Telegram ──────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram, copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# ── Wallet custody ────────────────────────────────────────────────────────
# 32-byte (64 hex char) master key used to wrap per-wallet data keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER reuse this value across environments. In production, replace this
# env var with a real KMS (AWS KMS / GCP KMS) — see README "Production hardening".
MASTER_ENCRYPTION_KEY=

# ── Per-chain network selection ──────────────────────────────────────────
# "testnet" (default, safe) or "mainnet" (real funds). Flip only after you've
# verified the chain end-to-end on its testnet/devnet.
SOLANA_NETWORK=testnet
ETHEREUM_NETWORK=testnet
BSC_NETWORK=testnet
BASE_NETWORK=testnet
MONAD_NETWORK=testnet
ROBINHOOD_NETWORK=testnet

# ── Solana ────────────────────────────────────────────────────────────────
# Helius: https://www.helius.dev (free tier has devnet + mainnet RPC + webhooks)
HELIUS_API_KEY=
SOLANA_DEVNET_RPC_URL="https://api.devnet.solana.com"
SOLANA_MAINNET_RPC_URL="https://mainnet.helius-rpc.com/?api-key=REPLACE_ME"
# Jupiter swap API is keyless for the public endpoint (rate-limited):
JUPITER_API_BASE="https://quote-api.jup.ag/v6"

# ── EVM (Ethereum, BSC, Base) ─────────────────────────────────────────────
# Alchemy: https://www.alchemy.com  |  QuickNode: https://www.quicknode.com
ALCHEMY_API_KEY=
QUICKNODE_ETHEREUM_URL=
QUICKNODE_BSC_URL=
QUICKNODE_BASE_URL=

ETHEREUM_TESTNET_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
ETHEREUM_MAINNET_RPC_URL=
BSC_TESTNET_RPC_URL="https://bsc-testnet-rpc.publicnode.com"
BSC_MAINNET_RPC_URL=
BASE_TESTNET_RPC_URL="https://base-sepolia-rpc.publicnode.com"
BASE_MAINNET_RPC_URL=

# Monad (EVM-compatible L1) — chain 143 mainnet / 10143 testnet.
MONAD_MAINNET_RPC_URL="https://rpc.monad.xyz"
# No default — Monad's testnet RPC is known to get reset/migrated; pull the
# current one from https://docs.monad.xyz right before use if this is stale.
MONAD_TESTNET_RPC_URL="https://testnet-rpc.monad.xyz"

# Robinhood Chain (Arbitrum Orbit L2 for tokenized stocks/RWAs) — chain 4663
# mainnet / 46630 testnet.
ROBINHOOD_MAINNET_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ROBINHOOD_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"

# Websocket RPC overrides for live subscriptions (new pairs, wallet activity).
# Auto-derived from the http(s) URLs above (scheme swapped to ws/wss) if unset
# — only fill these in if your provider needs a different websocket endpoint.
ETHEREUM_MAINNET_WS_URL=
ETHEREUM_TESTNET_WS_URL=
BSC_MAINNET_WS_URL=
BSC_TESTNET_WS_URL=
BASE_MAINNET_WS_URL=
BASE_TESTNET_WS_URL=
MONAD_MAINNET_WS_URL=
MONAD_TESTNET_WS_URL=
ROBINHOOD_MAINNET_WS_URL=
ROBINHOOD_TESTNET_WS_URL=

# Uniswap-V2-style factory/router/wrapped-native overrides. Ethereum (mainnet)
# and BSC (mainnet) already have working defaults baked in (see
# packages/chains/src/evm/config.ts) — you only need these for testnets, or
# to point Base/Monad/Robinhood Chain at a V2-fork DEX on either network.
# Robinhood Chain in particular is built for tokenized stocks/RWAs, not
# permissionless meme trading, and may not have one at all.
ETHEREUM_FACTORY_ADDRESS=
ETHEREUM_ROUTER_ADDRESS=
ETHEREUM_WRAPPED_NATIVE_ADDRESS=
BSC_FACTORY_ADDRESS=
BSC_ROUTER_ADDRESS=
BSC_WRAPPED_NATIVE_ADDRESS=
BASE_FACTORY_ADDRESS=
BASE_ROUTER_ADDRESS=
BASE_WRAPPED_NATIVE_ADDRESS=
MONAD_FACTORY_ADDRESS=
MONAD_ROUTER_ADDRESS=
MONAD_WRAPPED_NATIVE_ADDRESS=
ROBINHOOD_FACTORY_ADDRESS=
ROBINHOOD_ROUTER_ADDRESS=
ROBINHOOD_WRAPPED_NATIVE_ADDRESS=

# 1inch: https://portal.1inch.dev — real aggregator integration (mainnet only,
# Ethereum/BSC/Base; falls back to the direct V2 router when unset or on
# testnet, since 1inch has no testnet liquidity).
ONEINCH_API_KEY=

# Flashbots Protect (Ethereum mainnet only) — submits transactions through
# Flashbots instead of the public mempool for frontrunning/revert protection.
# Opt-in.
FLASHBOTS_ENABLED=false
FLASHBOTS_RPC_URL="https://rpc.flashbots.net"

# Jito (Solana mainnet only) — bundles the swap with a tip transaction via
# Jito's Block Engine for MEV-protected/priority inclusion. Opt-in. Verify
# JITO_TIP_ACCOUNTS against https://docs.jito.wtf before relying on this with
# real size — tip accounts do get rotated, and this hasn't been tested
# against a live funded wallet.
JITO_ENABLED=false
JITO_BLOCK_ENGINE_URL="https://mainnet.block-engine.jito.wtf/api/v1/bundles"
JITO_TIP_LAMPORTS=10000
JITO_TIP_ACCOUNTS="96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5,HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe"

# ── Pricing / pair discovery ──────────────────────────────────────────────
# Birdeye: https://birdeye.so/find-us (Solana + multi-chain token data)
BIRDEYE_API_KEY=
# DexScreener public API is keyless: https://docs.dexscreener.com/api/reference
DEXSCREENER_API_BASE="https://api.dexscreener.com"

# ── Cross-chain (Arbiter) ─────────────────────────────────────────────────
# LiFi: https://li.fi (route + bridge-cost estimation)
LIFI_API_KEY=

# ── Fees ──────────────────────────────────────────────────────────────────
# Fee percentage taken on profitable closed trades (0.02 = 2%)
PROFIT_FEE_RATE=0.02
# Treasury address to sweep collected fees to, per chain (optional in dev).
FEE_TREASURY_SOLANA_ADDRESS=
FEE_TREASURY_EVM_ADDRESS=

# ── Router / risk ─────────────────────────────────────────────────────────
# Auto take-profit / stop-loss, as a fraction of entry price (0.5 = +50%, 0.2 = -20%).
TAKE_PROFIT_PCT=0.5
STOP_LOSS_PCT=0.2
# Caps how many open positions Router will hold per chain across all users at once.
MAX_CONCURRENT_POSITIONS_PER_CHAIN=3
# How often (ms) the position monitor re-checks open positions for TP/SL triggers.
POSITION_MONITOR_INTERVAL_MS=15000
# How often (ms) Arbiter re-scans cross-chain prices for the tracked asset list.
ARBITER_SCAN_INTERVAL_MS=30000
# Placeholder bridging-cost assumption (0.005 = 0.5%) until a live LI.FI quote
# integration replaces it — see packages/specialists/arbiter/src/scan.ts.
ARBITER_ASSUMED_BRIDGE_COST_PCT=0.005
# Minimum spread (after the assumed bridge cost) before Arbiter reports an opportunity.
ARBITER_MIN_SPREAD_PCT=0.01

# ── AI features ───────────────────────────────────────────────────────────
# Off by default. When enabled: Guard's final qualitative review gate (after
# the mechanical checks pass), Scout's tweet interpretation, and Router's
# periodic TP/SL re-evaluation. Everything works with this off — it just
# means those three steps are skipped/no-op'd rather than the bot failing.
AI_FEATURES_ENABLED=false
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# How often (ms) Router re-evaluates TP/SL per open position via AI — separate
# from and much slower than the position monitor's per-tick price check.
AI_TP_SL_REVIEW_INTERVAL_MS=300000

# ── KOL / Twitter tracking (Scout) ────────────────────────────────────────
# X API v2 bearer token — the tiers that support monitoring specific
# accounts' posts are paid. https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=
# Comma-separated handles (no @) Scout watches for token calls.
KOL_TWITTER_HANDLES=
TWITTER_POLL_INTERVAL_MS=60000
